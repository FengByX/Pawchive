<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Search Bar + Sort trigger -->
    <LinearLayout
        android:id="@+id/search_sort_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="12dp"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                app:queryHint="@string/search_hint"
                app:searchIcon="@drawable/ic_search_outline"
                app:searchHintIcon="@null" />

        </com.google.android.material.card.MaterialCardView>

        <ImageButton
            android:id="@+id/btn_sort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_sort"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/select_sort"
            android:scaleType="centerInside"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

    <!-- Tabs row: now full width since sort moved into the search row -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:background="@android:color/transparent"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorTextSecondary"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:layout_constraintTop_toBottomOf="@+id/search_sort_row">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_posts" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_creators" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Filter chips row (FEATURE-004) -->
    <HorizontalScrollView
        android:id="@+id/filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_service"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_service"
                android:checked="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_attachment"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_has_attachment"
                android:checked="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_bookmarked"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_bookmarked"
                android:checked="false" />

            <!-- ARCH-FEATURE-001：离线全文搜索（收藏内容离线索引） -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_offline"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_offline"
                android:checked="false" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Thin divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="?attr/colorOutline"
        app:layout_constraintTop_toBottomOf="@+id/filter_scroll" />

    <!-- Content Container: FrameLayout ensures only one child is visible at a time -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">

        <!-- Results (default visible) -->
        <LinearLayout
            android:id="@+id/layout_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_results"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/tv_no_results"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/ic_search_large"
                            android:alpha="0.4"
                            app:tint="?attr/colorTextMuted"
                            android:contentDescription="@string/search_initial_hint" />

                        <TextView
                            android:id="@+id/tv_empty_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/search_initial_hint"
                            android:textColor="?attr/colorTextMuted"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <!-- 内嵌错误页（FEATURE-006）：列表为空且请求失败时展示，替代 Toast -->
                    <include
                        android:id="@+id/error_state_view"
                        layout="@layout/layout_error_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />

                </FrameLayout>

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <!-- Search History (default gone) -->
        <LinearLayout
            android:id="@+id/layout_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- History Header Row -->
            <LinearLayout
                android:id="@+id/history_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tv_history_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_history_title"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_all"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/search_history_clear_all"
                    android:textSize="15sp"
                    android:paddingHorizontal="8dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/done"
                    android:textSize="15sp"
                    android:paddingHorizontal="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />

        </LinearLayout>

        <!-- Progress Indicator (shared) -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_loading_circle"
            android:elevation="6dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorPrimary"
            android:layout_gravity="center"
            android:padding="8dp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
