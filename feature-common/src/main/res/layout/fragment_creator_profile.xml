<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Scrollable content: background + header + posts scroll together -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header area (avatar + name + actions) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/back"
                    app:tint="?attr/colorOnSurface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_creator_avatar" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_creator_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:layout_marginStart="12dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Pawchive.Thumbnail"
                    app:layout_constraintStart_toEndOf="@+id/btn_back"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_creator_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/creator_profile"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_creator_avatar"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_creator_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="12sp"
                    android:text="@string/creator_service_placeholder"
                    app:layout_constraintStart_toStartOf="@+id/tv_creator_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_creator_title" />

                <ImageButton
                    android:id="@+id/btn_creator_bookmark"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/btn_star_big_off"
                    android:contentDescription="@string/bookmark_creator_description"
                    app:tint="?attr/colorOnSurface"
                    app:layout_constraintEnd_toStartOf="@+id/btn_creator_subscribe"
                    app:layout_constraintTop_toBottomOf="@+id/iv_creator_avatar"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/btn_creator_subscribe"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="@string/subscribe_to_updates"
                    app:tint="?attr/colorOnSurface"
                    app:layout_constraintEnd_toStartOf="@+id/btn_block_creator"
                    app:layout_constraintTop_toBottomOf="@+id/iv_creator_avatar"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_block_creator"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/block_creator"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_shield"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconPadding="2dp"
                    app:backgroundTint="?attr/colorErrorContainer"
                    android:textColor="?attr/colorOnErrorContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_creator_avatar"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Announcements Section (collapsible) -->
            <LinearLayout
                android:id="@+id/layout_announcements_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_announcements_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/announcements" />

                <ImageView
                    android:id="@+id/ic_announcements_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/collapse" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_announcements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp" />

            <!-- Linked Accounts Section -->
            <TextView
                android:id="@+id/tv_links_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="@string/linked_accounts"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp" />

            <!-- Posts Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- Active Tab with indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/posts" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:background="?attr/colorPrimary" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Sort dropdown button -->
                <TextView
                    android:id="@+id/btn_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/sort_newest_added"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:drawableEndCompat="@drawable/ic_chevron_down"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    android:drawablePadding="4dp" />
            </LinearLayout>

            <!-- Search bar for creator posts (same style as SearchFragment) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_card_creator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/search_view_creator"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingStart="12dp"
                    android:iconifiedByDefault="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:queryHint="@string/search_creator_posts"
                    app:queryBackground="@android:color/transparent"
                    app:closeIcon="@drawable/ic_close"
                    app:searchIcon="@drawable/ic_search_outline"
                    app:searchHintIcon="@null" />

            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_creator_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:padding="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Load More Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_load_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="8dp"
                android:text="@string/load_more"
                android:visibility="gone"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_loading_circle"
        android:elevation="6dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
