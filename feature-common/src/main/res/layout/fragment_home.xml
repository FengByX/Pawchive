<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Header bar with app title and sort -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Row 1：标题 + 内容通知入口（标题独占整行宽度，避免被按钮挤压换行） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_subtitle"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- 内容更新通知入口：铃铛 + 未读徽标（ARCH-FEATURE-003）。
                 ImageView + 四边对称 padding 保证图标在圆内正中心
                 （Material3 IconButton 样式的固定 padding 按 40dp/24dp 设计，
                 自定义尺寸下图标会偏离圆心） -->
            <FrameLayout
                android:id="@+id/notification_entry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/btn_notifications"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_outline"
                    android:contentDescription="@string/content_updates"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_bell"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_notification_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:minWidth="16dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="3" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2：排序 + 批量管理（独立成行，标题不再参与宽度分配） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <!-- Sort button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/sort_label"
                android:textSize="12sp"
                app:icon="@drawable/ic_sort"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="?attr/colorPrimary"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="18dp" />

            <!-- 批量屏蔽入口（FEATURE）-->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/batch_manage"
                android:textSize="12sp"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="?attr/colorPrimary"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- 批量操作栏（FEATURE 首页批量屏蔽）：多选模式下显示 -->
        <LinearLayout
            android:id="@+id/batch_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tv_batch_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/batch_hint"
                android:textSize="13sp"
                android:textColor="?attr/colorTextSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_all"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_all"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_block_selected"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/block_selected"
                android:textSize="13sp"
                android:textColor="?attr/colorError"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_select"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/cancel"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Thin divider below header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="?attr/colorOutline" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_posts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_post" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Skeleton loading -->
    <include
        android:id="@+id/skeleton_view"
        layout="@layout/layout_skeleton_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_posts_found"
        android:textColor="?attr/colorTextMuted"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/swipe_refresh" />

    <!-- 内嵌错误页（FEATURE-006）：列表为空且请求失败时展示，替代 Toast -->
    <include
        android:id="@+id/error_state_view"
        layout="@layout/layout_error_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/swipe_refresh" />

</androidx.constraintlayout.widget.ConstraintLayout>

